# SERVER CONFIG
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# DATABASE (MONGODB)
MONGODB_CONNECTION_STRING=mongodb://localhost:27017/FySet

# REDIS CACHE & SESSION & OTP
REDIS_URL=redis://localhost:6379
REDIS_ENDPOINT=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT SECRET
JWT_SECRET_KEY=fyset_super_secret_jwt_key_2026

# GOOGLE NODEMAILER (GMAIL APP PASSWORD)
GOOGLE_NODEMAILER_USER_EMAIL=your_email@gmail.com
GOOGLE_NODEMAILER_APP_PASSWORD=your_16_char_app_password

# CLOUDINARY
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# PASSPORT OAUTH (GOOGLE & GITHUB)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
